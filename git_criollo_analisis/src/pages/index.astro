---
// src/pages/index.astro
import Dashboard from "../components/Dashboard.astro";
import { loadRepos } from "../lib/repos";
import { loadStatsMap } from "../lib/stats";

const repos = loadRepos();
const statsMap = loadStatsMap();
const repo = repos[0] ?? { name: "?", path: "?" };
const stats = repo.name !== "?" ? (statsMap[`../data/stats/${repo.name}.json`] ?? null) : null;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GitCriollo Analytics</title>
  </head>
  <body>
    <Dashboard repo={repo} repos={repos} stats={stats} />
  </body>
</html>