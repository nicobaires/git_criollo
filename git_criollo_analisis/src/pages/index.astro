---
import Dashboard from "../components/Dashboard.astro";
import { loadRepos } from "../lib/repos";
import { getStats } from "../lib/stats";
import "../styles/global.css";

const repos = loadRepos();
const repo = repos[0] ?? null;
const stats = repo ? getStats(repo.name) : null;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GitCriollo Analytics</title>
  </head>
  <body>
    <Dashboard repo={repo} repos={repos} stats={stats} />
  </body>
</html>