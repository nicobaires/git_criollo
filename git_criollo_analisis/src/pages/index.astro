---
// src/pages/index.astro
import KpiCard from '../components/KpiCard.svelte';
import Chart from '../components/Chart.svelte';
import Heatmap from '../components/Heatmap.svelte';
import stats from '../data/stats.json';

const { kpis, life_metrics, timeline, heatmap, hot_files, distribution } = stats;

const palette = ["#58a6ff", "#f0883e", "#3fb950", "#f85149", "#a371f7", "#d29922", "#f778ba", "#39c5cf"];

const authors = Object.keys(timeline.commits_by_author);

const commitsBarData = {
  labels: timeline.months,
  datasets: authors.map((author, i) => ({
    label: author,
    data: timeline.commits_by_author[author],
    backgroundColor: palette[i % palette.length],
  })),
};

const commitsBarOptions = {
  responsive: true,
  maintainAspectRatio: false,
  plugins: { legend: { position: "bottom" } },
  scales: {
    x: { stacked: true, grid: { display: false } },
    y: { stacked: true, beginAtZero: true },
  },
};

const distributionData = {
  labels: distribution.map((d) => d.author),
  datasets: [
    {
      data: distribution.map((d) => d.commits),
      backgroundColor: distribution.map((_, i) => palette[i % palette.length]),
      borderWidth: 0,
    },
  ],
};

const distributionOptions = {
  responsive: true,
  maintainAspectRatio: false,
  cutout: "62%",
  plugins: { legend: { position: "bottom" } },
};

const locLineData = {
  labels: timeline.loc_by_month.months,
  datasets: [
    {
      label: "Añadidas",
      data: timeline.loc_by_month.added,
      borderColor: "#3fb950",
      backgroundColor: "rgba(63, 185, 80, 0.12)",
      fill: true,
      tension: 0.3,
    },
    {
      label: "Eliminadas",
      data: timeline.loc_by_month.deleted,
      borderColor: "#f85149",
      backgroundColor: "rgba(248, 81, 73, 0.12)",
      fill: true,
      tension: 0.3,
    },
  ],
};

const locLineOptions = {
  responsive: true,
  maintainAspectRatio: false,
  plugins: { legend: { position: "bottom" } },
  scales: {
    x: { grid: { display: false } },
    y: { beginAtZero: true },
  },
};

const maxFileChanges = Math.max(...hot_files.map((f) => f.changes), 1);
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GitCriollo Analytics</title>
  <style>
    body { 
      margin: 0; 
      background: #0d1117; 
      color: #c9d1d9; 
      font-family: -apple-system, system-ui, sans-serif;
    }
    .dashboard {
      max-width: 1400px;
      margin: 0 auto;
      padding: 40px 24px;
    }
    .kpis-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 20px;
      margin-bottom: 32px;
    }
    .charts-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    .chart-card {
      background: #161b22;
      border: 1px solid #21262d;
      border-radius: 12px;
      padding: 20px;
    }
    .chart-card.span-2 { grid-column: span 2; }
    .chart-card h3 {
      margin: 0 0 16px 0;
      font-size: 15px;
      color: #e6edf3;
      font-weight: 600;
    }
    .chart-body {
      height: 320px;
      position: relative;
    }
    .chart-body canvas {
      width: 100% !important;
      height: 100% !important;
    }
    .hot-files {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .hot-file-info {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 4px;
    }
    .hot-file-path {
      font-size: 13px;
      color: #c9d1d9;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .hot-file-count {
      font-size: 13px;
      color: #8b949e;
      flex-shrink: 0;
    }
    .hot-file-bar {
      height: 6px;
      background: #21262d;
      border-radius: 3px;
      overflow: hidden;
    }
    .hot-file-bar-fill {
      height: 100%;
      background: #58a6ff;
      border-radius: 3px;
    }
    .empty { color: #8b949e; font-size: 14px; }
    @media (max-width: 1200px) {
      .kpis-grid { grid-template-columns: repeat(3, 1fr); }
      .charts-grid { grid-template-columns: 1fr; }
      .chart-card.span-2 { grid-column: span 1; }
    }
    @media (max-width: 768px) {
      .kpis-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <main class="dashboard">
    <h1 style="color: #58a6ff; margin: 0 0 8px 0;">GitCriollo Analytics</h1>
    <p style="color: #8b949e; margin: 0 0 32px 0;">
      {stats.meta.repo_name} · {stats.meta.branch} · {stats.timeline.months[0]} a {stats.timeline.months.at(-1)}
    </p>

    <div class="kpis-grid">
      <KpiCard 
        title="Commits" 
        value={kpis.total_commits} 
        subtitle={`↑ Actividad en ${life_metrics.active_days} días`}
        icon="📝"
        color="#58a6ff"
      />
      <KpiCard 
        title="Desarrolladores" 
        value={kpis.total_authors}
        icon="👥"
        color="#f0883e"
      />
      <KpiCard 
        title="Lineas añadidas" 
        value={kpis.total_added}
        icon="➕"
        color="#3fb950"
      />
      <KpiCard 
        title="Lineas eliminadas" 
        value={kpis.total_deleted}
        icon="➖"
        color="#f85149"
      />
      <KpiCard 
        title="Total cambios" 
        value={kpis.total_changes}
        icon="📈"
        color="#a371f7"
      />
    </div>

    <div class="charts-grid">
      <section class="chart-card span-2">
        <h3>Commits por autor y mes</h3>
        <div class="chart-body">
          <Chart client:load type="bar" data={commitsBarData} options={commitsBarOptions} />
        </div>
      </section>

      <section class="chart-card">
        <h3>Distribución por autor</h3>
        <div class="chart-body">
          <Chart client:load type="doughnut" data={distributionData} options={distributionOptions} />
        </div>
      </section>

      <section class="chart-card">
        <h3>Líneas por mes</h3>
        <div class="chart-body">
          <Chart client:load type="line" data={locLineData} options={locLineOptions} />
        </div>
      </section>

      <section class="chart-card">
        <h3>Archivos más tocados</h3>
        {hot_files.length === 0 ? (
          <p class="empty">Sin datos</p>
        ) : (
          <div class="hot-files">
            {hot_files.map((f) => (
              <div>
                <div class="hot-file-info">
                  <span class="hot-file-path">📄 {f.path}</span>
                  <span class="hot-file-count">{f.changes}</span>
                </div>
                <div class="hot-file-bar">
                  <div class="hot-file-bar-fill" style={`width: ${(f.changes / maxFileChanges) * 100}%`} />
                </div>
              </div>
            ))}
          </div>
        )}
      </section>

      <section class="chart-card span-2">
        <h3>Actividad diaria (últimas 52 semanas)</h3>
        <Heatmap data={heatmap} />
      </section>
    </div>
  </main>
</body>
</html>