---
import Dashboard from "../../components/Dashboard.astro";
import { loadRepos } from "../../lib/repos";
import { getStats } from "../../lib/stats";
import "../../styles/global.css";

const repos = loadRepos();
const repo = repos.find((r) => r.name === Astro.params.repo) ?? null;
const currentBranch = Astro.url.searchParams.get("branch") ?? "";
const stats = repo ? getStats(repo.name, currentBranch || undefined) : null;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{repo ? `${repo.name} · GitCriollo Analytics` : "No encontrado · GitCriollo Analytics"}</title>
  </head>
  <body>
    {repo ? (
      <Dashboard repo={repo} repos={repos} stats={stats} currentBranch={currentBranch} />
    ) : (
      <main class="max-w-[1400px] mx-auto py-10 px-6">
        <p class="text-gh-muted text-sm">No existe ese repositorio. <a href="/" class="text-gh-accent">Volver al dashboard</a></p>
      </main>
    )}
  </body>
</html>
