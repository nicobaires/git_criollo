---
import KpiCard from './KpiCard.svelte';
import Chart from './Chart.svelte';
import Heatmap from './Heatmap.svelte';
import AddRepo from './AddRepo.svelte';
import RemoveRepo from './RemoveRepo.svelte';
import BranchSelector from './BranchSelector.svelte';
import type { Repo } from '../lib/repos';
import type { Stats } from '../lib/stats';

interface Props {
  repo: Repo | null;
  repos: Repo[];
  stats: Stats | null;
  currentBranch: string;
}

const { repo, repos, stats, currentBranch } = Astro.props;

const palette = ["#58a6ff", "#f0883e", "#3fb950", "#f85149", "#a371f7", "#d29922", "#f778ba", "#39c5cf"];

const TOP_N = 6;
const OTROS_COLOR = "#7d8590";

let kpis, life_metrics, timeline, heatmap, hot_files, distribution;
let commitsBarData, commitsBarOptions;
let distributionData, distributionOptions;
let locLineData, locLineOptions;
let maxFileChanges = 1;
let totalAuthors = 0;

if (stats) {
  ({ kpis, life_metrics, timeline, heatmap, hot_files, distribution } = stats);
  totalAuthors = distribution.length;

  const topDistribution = distribution.slice(0, TOP_N);
  const otherDistribution = distribution.slice(TOP_N);

  const groupedDistribution = otherDistribution.length > 0
    ? [...topDistribution, {
        author: "Otros",
        commits: otherDistribution.reduce((s, d) => s + d.commits, 0),
        percentage: Math.round(otherDistribution.reduce((s, d) => s + d.percentage, 0) * 10) / 10,
      }]
    : topDistribution;

  const sortedAuthors = Object.entries(timeline.commits_by_author)
    .map(([author, months]) => ({
      author,
      total: months.reduce((s, v) => s + v, 0),
      months,
    }))
    .sort((a, b) => b.total - a.total);

  const topAuthors = sortedAuthors.slice(0, TOP_N);
  const restAuthors = sortedAuthors.slice(TOP_N);

  const lineDatasets = topAuthors.map((a, i) => ({
    label: a.author,
    data: a.months,
    borderColor: palette[i % palette.length],
    backgroundColor: palette[i % palette.length] + "20",
    borderWidth: 2,
    tension: 0.3,
    pointRadius: 3,
    pointHoverRadius: 5,
    fill: false,
  }));

  if (restAuthors.length > 0) {
    lineDatasets.push({
      label: "Otros",
      data: timeline.months.map((_, i) => restAuthors.reduce((s, a) => s + a.months[i], 0)),
      borderColor: OTROS_COLOR,
      backgroundColor: OTROS_COLOR + "20",
      borderWidth: 2,
      borderDash: [6, 3],
      tension: 0.3,
      pointRadius: 3,
      pointHoverRadius: 5,
      fill: false,
    });
  }

  commitsBarData = {
    labels: timeline.months,
    datasets: lineDatasets,
  };

  commitsBarOptions = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { position: "bottom" } },
    scales: {
      x: { grid: { display: false } },
      y: { beginAtZero: true },
    },
  };

  distributionData = {
    labels: groupedDistribution.map((d) => d.author),
    datasets: [
      {
        data: groupedDistribution.map((d) => d.commits),
        backgroundColor: groupedDistribution.map((_, i) =>
          i < topAuthors.length ? palette[i % palette.length] : OTROS_COLOR
        ),
        borderWidth: 0,
      },
    ],
  };

  distributionOptions = {
    responsive: true,
    maintainAspectRatio: false,
    cutout: "62%",
    plugins: { legend: { position: "bottom" } },
  };

  locLineData = {
    labels: timeline.loc_by_month.months,
    datasets: [
      {
        label: "Añadidas",
        data: timeline.loc_by_month.added,
        backgroundColor: "#3fb950",
      },
      {
        label: "Eliminadas",
        data: timeline.loc_by_month.deleted,
        backgroundColor: "#f85149",
      },
    ],
  };

  locLineOptions = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { position: "bottom" } },
    scales: {
      x: { grid: { display: false } },
      y: { beginAtZero: true },
    },
  };

  maxFileChanges = Math.max(...hot_files.map((f) => f.changes), 1);
}
---

<main class="max-w-[1400px] mx-auto py-10 px-6">
  <header class="mb-8">
    <div class="flex items-center gap-4 mb-2">
      <h1 class="text-gh-accent text-2xl font-bold m-0">GitCriollo Analytics</h1>
      <AddRepo client:load />
    </div>
    {repos.length > 0 && repo && (
      <nav class="flex flex-wrap gap-2 mb-2" aria-label="Repositorios">
        {repos.map((r) => (
          <div class:list={[
            "repo-pill-wrap inline-flex items-center rounded-full border border-gh-border bg-gh-card transition-colors hover:border-gh-accent",
            r.name === repo.name && "border-gh-accent bg-[rgba(88,166,255,0.12)]",
          ]}>
            <a
              href={`/repo/${r.name}`}
              class:list={[
                "inline-block py-1.5 pl-3.5 pr-1 text-[13px] no-underline transition-colors",
                r.name === repo.name ? "text-gh-hover" : "text-gh-muted hover:text-gh-text",
              ]}
              title={r.path}
            >
              {r.name}
            </a>
            <RemoveRepo name={r.name} client:load />
          </div>
        ))}
      </nav>
    )}
    {repo && (
      <div class="flex items-center gap-4 flex-wrap">
        <p class="text-gh-muted text-sm m-0">
          <span class="font-mono text-xs" title={repo.path}>{repo.path}</span>
          {stats && (
            <span> · {stats.timeline.months[0]} a {stats.timeline.months.at(-1)}</span>
          )}
        </p>
        <BranchSelector repo={repo.name} current={currentBranch} client:load />
      </div>
    )}
  </header>

  {!repo ? (
    <p class="text-gh-muted text-sm">
      No hay repositorios configurados. Usá <strong>+ Agregar repo</strong> y pegá la
      ruta de una carpeta con un repositorio Git.
    </p>
  ) : !stats ? (
    <p class="text-gh-muted text-sm">
      No hay datos para <strong>{repo.name}</strong> (branch: {currentBranch}). Se están generando o los podés
      generar manualmente con:
      <code class="bg-gh-card border border-gh-border rounded px-1.5 py-0.5 text-xs">python script/extract_stats.py --all</code>
    </p>
  ) : (
    <>
      <div class="grid grid-cols-5 gap-5 mb-8 max-xl:grid-cols-3 max-md:grid-cols-1">
        <KpiCard
          title="Commits"
          value={kpis.total_commits}
          subtitle={`↑ Actividad en ${life_metrics.active_days} días`}
          icon="📝"
          color="#58a6ff"
        />
        <KpiCard
          title="Desarrolladores"
          value={kpis.total_authors}
          icon="👥"
          color="#f0883e"
        />
        <KpiCard
          title="Lineas añadidas"
          value={kpis.total_added}
          icon="➕"
          color="#3fb950"
        />
        <KpiCard
          title="Lineas eliminadas"
          value={kpis.total_deleted}
          icon="➖"
          color="#f85149"
        />
        <KpiCard
          title="Total cambios"
          value={kpis.total_changes}
          icon="📈"
          color="#a371f7"
        />
      </div>

      <div class="grid grid-cols-2 gap-5 max-xl:grid-cols-1">
        <section class="bg-gh-card border border-gh-border rounded-xl p-5 col-span-2 max-xl:col-span-1">
          <h3 class="text-gh-hover text-[15px] font-semibold mt-0 mb-4">Commits por autor y mes</h3>
          <div class="h-80 relative">
            <Chart client:load type="line" data={commitsBarData} options={commitsBarOptions} />
          </div>
        </section>

        <section class="bg-gh-card border border-gh-border rounded-xl p-5">
          <h3 class="text-gh-hover text-[15px] font-semibold mt-0 mb-4">Distribución por autor</h3>
          <div class="h-80 relative">
            <Chart client:load type="doughnut" data={distributionData} options={distributionOptions} />
          </div>
          {totalAuthors > TOP_N && (
            <p class="text-gh-muted text-xs mt-3 text-center">{totalAuthors} autores en total</p>
          )}
        </section>

        <section class="bg-gh-card border border-gh-border rounded-xl p-5">
          <h3 class="text-gh-hover text-[15px] font-semibold mt-0 mb-4">Líneas por mes</h3>
          <div class="h-80 relative">
            <Chart client:load type="bar" data={locLineData} options={locLineOptions} />
          </div>
        </section>

        <section class="bg-gh-card border border-gh-border rounded-xl p-5">
          <h3 class="text-gh-hover text-[15px] font-semibold mt-0 mb-4">Archivos más tocados</h3>
          {hot_files.length === 0 ? (
            <p class="text-gh-muted text-sm">Sin datos</p>
          ) : (
            <div class="flex flex-col gap-3">
              {hot_files.map((f) => (
                <div>
                  <div class="flex justify-between gap-3 mb-1">
                    <span class="text-[13px] text-gh-text overflow-hidden text-ellipsis whitespace-nowrap">📄 {f.path}</span>
                    <span class="text-[13px] text-gh-muted shrink-0">{f.changes}</span>
                  </div>
                  <div class="h-1.5 bg-gh-border rounded-[3px] overflow-hidden">
                    <div class="h-full bg-gh-accent rounded-[3px]" style={`width: ${(f.changes / maxFileChanges) * 100}%`} />
                  </div>
                </div>
              ))}
            </div>
          )}
        </section>

        <section class="bg-gh-card border border-gh-border rounded-xl p-5 col-span-2 max-xl:col-span-1">
          <h3 class="text-gh-hover text-[15px] font-semibold mt-0 mb-4">Actividad diaria</h3>
          <Heatmap data={heatmap} />
        </section>
      </div>
    </>
  )}
</main>

<style>
  .repo-pill-wrap:has(:global(.remove-btn-confirm)) {
    border-color: #f85149;
    background: rgba(248, 81, 73, 0.1);
  }
</style>
